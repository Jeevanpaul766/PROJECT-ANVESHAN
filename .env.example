# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
ANVESHAN_HOST=127.0.0.1
ANVESHAN_PORT=4747

# ─────────────────────────────────────────────────────────────────────────────
# LLM — Multi-provider waterfall router
# The agent tries providers in order: Gemini → Groq → OpenRouter → HuggingFace
# Each provider is only used when its API key is set.
# You need at least one key for the LLM to work.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Google Gemini (PRIMARY — best free quota + huge context)
#    Get key: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=
ANVESHAN_GEMINI_MODEL=gemini-2.0-flash
# ANVESHAN_GEMINI_FAST_MODEL=gemini-2.0-flash
# ANVESHAN_GEMINI_SMART_MODEL=gemini-2.0-flash

# 2. Groq (FAST FALLBACK — extremely fast inference)
#    Get key: https://console.groq.com/keys
GROQ_API_KEY=
ANVESHAN_GROQ_MODEL=llama-3.3-70b-versatile
# ANVESHAN_GROQ_FAST_MODEL=llama3-8b-8192
# ANVESHAN_GROQ_SMART_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter (MODEL DIVERSITY FALLBACK — 100s of models through one API)
#    Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
ANVESHAN_OPENROUTER_MODEL=google/gemma-3-27b-it:free
# ANVESHAN_OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
# ANVESHAN_OPENROUTER_SMART_MODEL=qwen/qwen-2.5-72b-instruct:free

# 4. Hugging Face (FINAL FALLBACK — open-source models)
#    Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
ANVESHAN_HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# ANVESHAN_HF_FAST_MODEL=Qwen/Qwen2.5-7B-Instruct
# ANVESHAN_HF_SMART_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# ─────────────────────────────────────────────────────────────────────────────
# Search providers
# ─────────────────────────────────────────────────────────────────────────────
# Brave Search API key — free tier: 2000 queries/month
# Get yours at: https://brave.com/search/api/
ANVESHAN_BRAVE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Research loop limits
# ─────────────────────────────────────────────────────────────────────────────
ANVESHAN_MAX_ROUNDS=5
ANVESHAN_MAX_FINDINGS=100
ANVESHAN_MAX_QUERIES_PER_ROUND=8
ANVESHAN_MAX_SOURCES=100
